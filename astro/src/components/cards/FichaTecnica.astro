---
// Propuesta A · «Ficha técnica». La card es una hoja de especificación: índice,
// segmento, título y tres cifras reales. Con puntero fino, la foto entra con un
// barrido diagonal en el ángulo del corte y el filete partido se dibuja.
// En táctil la foto ya viene arriba (no hay hover que esperar).
import { Picture } from "astro:assets";
import Flecha from "../Flecha.astro";
import { miles, indice, type ProyectoMuestra } from "../../data/proyectos-muestra";

interface Props {
  p: ProyectoMuestra;
  i: number;
  total: number;
  href?: string;
}
const { p, i, total, href = "#" } = Astro.props;
---

<li class:list={["ficha-celda", `i-${i % 6}`]} data-revela>
  <a class="ficha corte" href={href}>
    <span class="ficha-media corte" aria-hidden="true">
      <Picture src={p.foto} formats={["avif", "webp"]} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 45vw, 92vw" alt="" class="ficha-img" />
      <span class="ficha-velo"></span>
    </span>

    <span class="ficha-cuerpo">
      <span class="ficha-top">
        <span class="cifra ficha-num">{indice(i, total)}</span>
        <span class="rotulo ficha-seg">{p.segmento}</span>
      </span>

      <h3 class="ficha-titulo">{p.titulo}</h3>
      {p.cliente && <p class="ficha-cliente">{p.cliente}</p>}

      <dl class="ficha-datos">
        <div>
          <dt class="rotulo">Superficie</dt>
          <dd class="cifra">{miles(p.metros)}<span> m²</span></dd>
        </div>
        <div>
          <dt class="rotulo">Equipos</dt>
          <dd class="cifra">{p.equipos}</dd>
        </div>
        <div>
          <dt class="rotulo">Año</dt>
          <dd class="cifra">{p.anio}</dd>
        </div>
      </dl>

      <span class="ficha-pie">
        <span class="filete ficha-filete"></span>
        <span class="ficha-ver">Ver proyecto <Flecha /></span>
      </span>
    </span>
  </a>
</li>

<style>
  .ficha-celda {
    list-style: none;
  }
  .ficha {
    --corte: 1.5rem;
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-papel-2);
    color: var(--color-tinta);
    text-decoration: none;
  }

  /* Táctil / sin hover: foto arriba, fija. */
  .ficha-media {
    --corte: 1.5rem;
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .ficha-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ficha-velo {
    display: none;
  }

  .ficha-cuerpo {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.5rem 1.5rem 1.4rem;
  }
  .ficha-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .ficha-num {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-azul);
  }
  .ficha-titulo {
    margin-top: 1.1rem;
    font-size: clamp(1.35rem, 1.1rem + 0.9vw, 1.75rem);
    font-weight: 700;
    line-height: 1.12;
  }
  .ficha-cliente {
    margin-top: 0.4rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-azul);
  }
  .ficha-datos {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 1rem;
    margin-top: auto;
    padding-top: 2rem;
  }
  .ficha-datos dd {
    margin-top: 0.35rem;
    font-size: clamp(1.4rem, 1.15rem + 0.8vw, 1.9rem);
    font-weight: 600;
    line-height: 1;
  }
  .ficha-datos dd span {
    font-size: 0.55em;
    font-weight: 500;
  }
  .ficha-pie {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .ficha-filete {
    flex: 1;
    transform: scaleX(0.18);
    transition: transform var(--dur-larga) var(--ease-barrido);
  }
  .ficha-ver {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .ficha:focus-visible {
    outline-offset: 4px;
  }

  /* Puntero fino: la foto se guarda y entra con el barrido diagonal. */
  @media (hover: hover) and (pointer: fine) {
    .ficha-media {
      position: absolute;
      inset: 0;
      z-index: -1;
      aspect-ratio: auto;
      clip-path: polygon(0 0, 0 0, -60% 100%, -60% 100%);
      transition: clip-path 0.8s var(--ease-barrido);
    }
    .ficha-media :global(img) {
      scale: 1.08;
      transition: scale 1.6s var(--ease-salida);
    }
    .ficha-velo {
      display: block;
      position: absolute;
      inset: 0;
      background: rgb(27 35 44 / 0.78);
    }
    .ficha-cuerpo {
      min-height: 24rem;
      padding: 1.75rem;
    }
    .ficha-cuerpo,
    .ficha-num,
    .ficha-seg,
    .ficha-cliente,
    .ficha-datos dt {
      /* El color cambia cuando el barrido ya pasó la mitad: nunca claro sobre claro. */
      transition: color 0.35s var(--ease-salida) 0.28s;
    }

    .ficha:hover .ficha-media,
    .ficha:focus-visible .ficha-media {
      clip-path: polygon(0 0, 160% 0, 100% 100%, -60% 100%);
    }
    .ficha:hover .ficha-media :global(img),
    .ficha:focus-visible .ficha-media :global(img) {
      scale: 1;
    }
    .ficha:hover .ficha-cuerpo,
    .ficha:focus-visible .ficha-cuerpo,
    .ficha:hover .ficha-seg,
    .ficha:focus-visible .ficha-seg,
    .ficha:hover .ficha-datos dt,
    .ficha:focus-visible .ficha-datos dt {
      color: var(--color-papel);
    }
    .ficha:hover .ficha-num,
    .ficha:focus-visible .ficha-num,
    .ficha:hover .ficha-cliente,
    .ficha:focus-visible .ficha-cliente {
      color: var(--color-niebla);
    }
    .ficha:hover .ficha-filete,
    .ficha:focus-visible .ficha-filete {
      transform: scaleX(1);
    }
    .ficha:hover :global(.flecha),
    .ficha:focus-visible :global(.flecha) {
      translate: 0.35rem 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ficha *,
    .ficha :global(img) {
      transition-duration: 0.01ms !important;
    }
  }
</style>
