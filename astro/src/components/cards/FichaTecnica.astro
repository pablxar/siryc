---
// Ficha técnica de proyecto: el molde Ficha con las tres cifras reales (m², equipos, año).
import Ficha from "../Ficha.astro";
import Cifras from "../Cifras.astro";
import { indice, type ProyectoMuestra } from "../../data/proyectos-muestra";

interface Props {
  p: ProyectoMuestra;
  i: number;
  total: number;
  href?: string;
}
const { p, i, total, href = "#" } = Astro.props;
---

<li class:list={["ficha-celda", `i-${i % 6}`]} data-revela>
  <Ficha href={href} indice={indice(i, total)} rotulo={p.segmento} titulo={p.titulo} destacado={p.cliente} foto={p.foto} enlace="Ver proyecto" contenidoAbajo>
    <Cifras metros={p.metros} equipos={p.equipos} anio={p.anio} />
  </Ficha>
</li>

<style>
  .ficha-celda {
    list-style: none;
  }
</style>
