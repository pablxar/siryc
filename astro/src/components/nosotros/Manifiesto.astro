---
// Pausa tipográfica: una frase grande que sube por líneas sobre tinta, con el eslogan como firma.
interface Props {
  lineas: string[];
  firma: string;
}
const { lineas, firma } = Astro.props;
---

<section class="manifiesto" data-lineas aria-label="Manifiesto">
  <div class="contenedor">
    <p class="manifiesto-frase">
      {lineas.map((l, i) => <span class={`linea i-${i}`}><span>{l}</span></span>)}
    </p>
    <span class="filete filete--claro dibuja manifiesto-filete" aria-hidden="true"></span>
    <p class="rotulo manifiesto-firma sigue i-2">{firma}</p>
  </div>
</section>

<style>
  .manifiesto {
    padding: 5.5rem 0;
    background: var(--color-tinta);
    color: var(--color-papel);
  }
  .manifiesto-frase {
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.2rem + 3.6vw, 4.5rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .manifiesto-filete {
    width: 9rem;
    height: 4px;
    margin-top: 2rem;
  }
  .manifiesto-firma {
    margin-top: 1.25rem;
    color: var(--color-niebla);
  }
  @media (min-width: 1024px) {
    .manifiesto {
      padding: 9rem 0;
    }
  }
</style>
