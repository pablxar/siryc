---
// GRILLA QUIETA: las áreas del equipo, para leer libre. Número + filete + área + función. Sin íconos.
interface Area {
  nombre: string;
  funcion: string;
}
interface Props {
  areas: Area[];
}
const { areas } = Astro.props;
---

<ol class="equipo">
  {
    areas.map((a, i) => (
      <li class={`i-${i}`} data-revela>
        <span class="cifra equipo-num">{String(i + 1).padStart(2, "0")}</span>
        <span class="filete equipo-filete" aria-hidden="true" />
        <h3>{a.nombre}</h3>
        <p>{a.funcion}</p>
      </li>
    ))
  }
</ol>

<style>
  .equipo {
    display: grid;
    gap: 2rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 640px) {
    .equipo {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .equipo {
      grid-template-columns: repeat(4, 1fr);
      gap: 2.5rem;
    }
  }
  .equipo-num {
    display: block;
    font-size: clamp(2.5rem, 1.8rem + 2.4vw, 4rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-azul);
  }
  .equipo-filete {
    width: 4.5rem;
    margin: 1.25rem 0 1rem;
  }
  h3 {
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.15;
  }
  p {
    margin-top: 0.4rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-grafito);
  }
</style>
