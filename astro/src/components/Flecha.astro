---
// Flecha propia de SIRYC: trazo recto, punta abierta, remates sin redondear.
interface Props {
  class?: string;
}
const { class: clase } = Astro.props;
---

<svg class:list={["flecha", clase]} viewBox="0 0 26 12" width="26" height="12" aria-hidden="true" focusable="false">
  <path d="M0 6H24M18 0.8L24 6L18 11.2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="butt" stroke-linejoin="miter"></path>
</svg>

<style>
  .flecha {
    flex: none;
    transition: translate 0.7s var(--ease-salida);
  }
</style>
