---
// Entrada de marca (solo portada, solo al llegar desde fuera del sitio; ver Base.astro).
// El isotipo se arma (engranaje, copo, frío, calor), el telón sube y destapa la cabecera,
// y el símbolo vuela al isotipo del logo, que ya está debajo: nunca un corte.
// Se salta con clic, tecla, rueda o toque. Sin JS o con movimiento reducido no existe.
import Isotipo from "./Isotipo.astro";
---

<div class="entrada" aria-hidden="true" data-entrada>
  <div class="entrada-telon"></div>
  <Isotipo class="entrada-iso" titulo="" />
</div>

<style>
  .entrada {
    display: none;
  }
  :global(html.con-entrada) .entrada {
    position: fixed;
    inset: 0;
    z-index: 70;
    display: grid;
    place-items: center;
    pointer-events: none;
    /* Salvavidas: si el script no corre, desaparece igual. */
    animation: entrada-salvavidas 0s 4.5s forwards;
  }
  .entrada-telon {
    position: absolute;
    inset: 0;
    background: var(--color-papel);
  }
  .entrada :global(.entrada-iso) {
    position: relative;
    width: clamp(5.5rem, 4rem + 6vw, 8rem);
    height: auto;
    transform-origin: 0 0;
  }
  /* Todo parte oculto desde CSS: nada se ve antes de que empiece la animación. */
  .entrada :global(.iso > g),
  .entrada :global(.iso-copo path) {
    opacity: 0;
  }
  @keyframes entrada-salvavidas {
    to {
      visibility: hidden;
    }
  }
</style>

<script>
  const raiz = document.documentElement;
  const capa = document.querySelector<HTMLElement>("[data-entrada]");

  if (capa && raiz.classList.contains("con-entrada")) {
    const iso = capa.querySelector<SVGSVGElement>(".entrada-iso")!;
    const telon = capa.querySelector<HTMLElement>(".entrada-telon")!;
    const destino = document.querySelector<SVGGElement>(".cabecera-logo .iso");
    const SALIDA = "cubic-bezier(0.16, 1, 0.3, 1)";
    const BARRIDO = "cubic-bezier(0.65, 0, 0.35, 1)";
    const anims: Animation[] = [];
    const a = (el: Element, k: Keyframe[], o: KeyframeAnimationOptions) => {
      const an = el.animate(k, { fill: "both", ...o });
      anims.push(an);
      return an;
    };
    let terminado = false;

    const terminar = () => {
      if (terminado) return;
      terminado = true;
      raiz.classList.add("entrada-fin");
      const fuera = capa.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 220, fill: "both" });
      fuera.onfinish = () => {
        anims.forEach((an) => an.cancel());
        capa.remove();
      };
      quitarSaltos();
      document.dispatchEvent(new Event("entrada:fin"));
    };

    // Saltar: clic, tecla, rueda o toque.
    const saltar = () => terminar();
    const eventos = ["pointerdown", "keydown", "wheel", "touchstart"] as const;
    const quitarSaltos = () => eventos.forEach((ev) => window.removeEventListener(ev, saltar));
    eventos.forEach((ev) => window.addEventListener(ev, saltar, { passive: true }));

    // 1 · Se arma el isotipo (~1,3 s). Total con el vuelo: ~2,3 s.
    const engranaje = iso.querySelector(".iso-engranaje")!;
    const copo = iso.querySelector(".iso-copo")!;
    a(engranaje, [{ opacity: 0, transform: "rotate(-110deg) scale(0.86)" }, { opacity: 1, transform: "none" }], { duration: 900, easing: SALIDA });
    a(copo, [{ opacity: 1 }, { opacity: 1 }], { duration: 1 });
    copo.querySelectorAll("path").forEach((p, k) =>
      a(p, [{ opacity: 0, transform: "scale(0.3)" }, { opacity: 1, transform: "none" }], { duration: 550, delay: 200 + k * 18, easing: SALIDA }),
    );
    a(iso.querySelector(".iso-frio")!, [{ opacity: 0, transform: "rotate(50deg)" }, { opacity: 1, transform: "none" }], { duration: 700, delay: 520, easing: SALIDA });
    const ultimo = a(iso.querySelector(".iso-calor")!, [{ opacity: 0, transform: "rotate(-50deg)" }, { opacity: 1, transform: "none" }], {
      duration: 700,
      delay: 620,
      easing: SALIDA,
    });

    // 2 · Sube el telón (destapa cabecera y portada) y el símbolo vuela al logo.
    ultimo.finished
      .then(() => {
        if (terminado) return;
        a(telon, [{ clipPath: "inset(0 0 0 0)" }, { clipPath: "inset(0 0 100% 0)" }], { duration: 750, easing: BARRIDO });
        if (!destino) return terminar();
        // Se calza el dibujo (no la caja del SVG): origen del SVG arriba a la izquierda.
        const caja = iso.getBoundingClientRect();
        const desde = iso.querySelector(".iso")!.getBoundingClientRect();
        const hasta = destino.getBoundingClientRect();
        const s = hasta.width / desde.width;
        const dx = hasta.left - (desde.left - caja.left) * s - caja.left;
        const dy = hasta.top - (desde.top - caja.top) * s - caja.top;
        const vuelo = a(
          iso,
          [{ transform: "none" }, { transform: `translate(${dx}px, ${dy}px) scale(${s})` }],
          { duration: 850, delay: 120, easing: BARRIDO },
        );
        return vuelo.finished.then(terminar);
      })
      .catch(terminar);
  }
</script>
