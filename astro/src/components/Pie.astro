---
// Pie: simétrico y mínimo. Sin redes sociales hasta tener los enlaces reales (hoy apuntan a «#»).
import Logo from "./Logo.astro";

const sitio = [
  { href: "/nosotros", texto: "Nosotros" },
  { href: "/servicios", texto: "Servicios" },
  { href: "/proyectos", texto: "Proyectos" },
  { href: "/blog", texto: "Actualidad" },
  { href: "/contacto", texto: "Contacto" },
];
const servicios = [
  "Refrigeración industrial",
  "Climatización y aire acondicionado",
  "Electricidad industrial",
  "Contratos de mantención",
];
const anio = new Date().getFullYear();
---

<footer class="pie">
  <div class="contenedor">
    <div class="pie-marca">
      <a href="/" aria-label="SIRYC, ir al inicio"><Logo class="logo--claro" /></a>
      <p>Tu clima, nuestra ingeniería.</p>
    </div>

    <span class="filete pie-filete" aria-hidden="true"></span>

    <div class="pie-columnas">
      <nav aria-label="Sitio">
        <p class="rotulo">Sitio</p>
        <ul>{sitio.map((e) => <li><a href={e.href}>{e.texto}</a></li>)}</ul>
      </nav>
      <div>
        <p class="rotulo">Servicios</p>
        <ul>{servicios.map((s) => <li>{s}</li>)}</ul>
      </div>
      <div>
        <p class="rotulo">Contacto</p>
        <ul>
          <li><a href="mailto:ventas@siryc.cl">ventas@siryc.cl</a></li>
          <li>V Región, Chile</li>
        </ul>
      </div>
    </div>

    <div class="pie-legal">
      <span>© {anio} SIRYC SpA</span>
      <span class="pie-legal-enlaces">
        <a href="/terminos">Términos</a>
        <a href="/privacidad">Privacidad</a>
      </span>
    </div>
  </div>
</footer>

<style>
  .pie {
    padding: 4.5rem 0 2rem;
    background: var(--color-tinta);
    color: var(--color-niebla);
  }
  .pie-marca {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }
  .pie-marca :global(.logo) {
    display: block;
    height: 2.6rem;
    width: auto;
  }
  .pie-marca p {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-papel);
  }
  .pie-filete {
    width: 6rem;
    margin: 2.5rem auto;
  }
  .pie-columnas {
    display: grid;
    gap: 2rem;
    text-align: center;
  }
  @media (min-width: 720px) {
    .pie-columnas {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .pie .rotulo {
    color: var(--color-niebla);
  }
  .pie ul {
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
    font-size: 0.9375rem;
    color: var(--color-papel);
  }
  .pie a {
    color: var(--color-papel);
    text-decoration: none;
    transition: color 0.4s var(--ease-salida);
  }
  .pie li a {
    display: inline-block;
    padding: 0.2rem 0;
  }
  @media (hover: hover) {
    .pie a:hover {
      color: var(--color-niebla);
    }
  }
  .pie-legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(176 190 197 / 0.25);
    font-size: 0.8125rem;
  }
  .pie-legal-enlaces {
    display: flex;
    gap: 1.5rem;
  }
  @media (max-width: 719px) {
    .pie-legal {
      justify-content: center;
      text-align: center;
    }
  }
</style>
