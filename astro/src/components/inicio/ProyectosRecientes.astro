---
// 03 · Proyectos recientes como DESFILE HORIZONTAL (ver Desfile.astro): la prueba, obra tras obra.
// Datos de Supabase al compilar; fotos provisorias por segmento.
import Desfile from "../Desfile.astro";
import Ficha from "../Ficha.astro";
import Cifras from "../Cifras.astro";
import SeccionTitulo from "../SeccionTitulo.astro";
import { proyectos, SEGMENTO, type Proyecto } from "../../lib/supabase";
import refrigeracion from "../../assets/refrigeracion.png";
import climatizacion from "../../assets/climatizacion.png";
import electricidad from "../../assets/electricidad.png";
import banner from "../../assets/banner-web-siryc.png";

const FOTO: Record<NonNullable<Proyecto["categoria"]>, ImageMetadata> = {
  centro_comercial: climatizacion,
  gobierno: refrigeracion,
  corporativo: electricidad,
  educacion: banner,
};
const lista = await proyectos(6);
const total = lista.length;
---

{
  total > 0 && (
    <Desfile n={total} etiqueta="proy-t">
      <SeccionTitulo
        slot="cabeza"
        id="proy-t"
        numero="03"
        rotulo="Proyectos"
        lineas={["Proyectos recientes."]}
        enlace={{ href: "/proyectos", texto: "Ver todos los proyectos" }}
      />
      {lista.map((p, i) => (
        <li class={`i-${Math.min(i, 5)}`}>
          <Ficha
            href={`/proyectos#${p.id}`}
            indice={`${String(i + 1).padStart(2, "0")} / ${String(total).padStart(2, "0")}`}
            rotulo={p.categoria ? SEGMENTO[p.categoria] : undefined}
            titulo={p.titulo}
            destacado={p.cliente_nombre_publico}
            foto={p.categoria ? FOTO[p.categoria] : undefined}
            enlace="Ver proyecto"
            contenidoAbajo
            sizes="(min-width: 1024px) 30rem, 82vw"
          >
            <Cifras metros={p.metros_cuadrados} equipos={p.cantidad_equipos} anio={p.anio} />
          </Ficha>
        </li>
      ))}
    </Desfile>
  )
}
